{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icon_ImmersiveTL.png",
    "32": "icon_ImmersiveTL.png",
    "48": "icon_ImmersiveTL.png",
    "128": "icon_ImmersiveTL.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": [
        "common.js",
        "content/drag.js",
        "content/settings.js",
        "content/history.js",
        "content/translator.js",
        "content/translation-trigger.js",
        "content/caption-processor.js",
        "content/overlay.js",
        "content/caption-source.js",
        "content/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle_history": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Command+H"
      },
      "description": "__MSG_cmdToggleHistory__"
    },
    "toggle_subtitle": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+S"
      },
      "description": "__MSG_cmdToggleSubtitle__"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ImmerseTL",
    "default_icon": {
      "16": "icon_ImmersiveTL.png",
      "32": "icon_ImmersiveTL.png",
      "48": "icon_ImmersiveTL.png",
      "128": "icon_ImmersiveTL.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/fonts/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
